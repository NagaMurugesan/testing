version: '3.8'

services:
  backend:
    build: ./backend
    ports:
      - "8000:8000"
    environment:
      - AWS_REGION=us-east-1
      # Ensure you pass AWS credentials when running this compose file or have them in ~/.aws/credentials mounted
    volumes:
      - ./backend:/app # Optional: for hot reloading if you run uvicorn with --reload

  frontend:
    build: ./frontend
    ports:
      - "80:80"
    depends_on:
      - backend
