import os
import boto3
import logging

logger = logging.getLogger()
logger.setLevel(logging.INFO)

iam = boto3.client("iam")

def lambda_handler(event, context):
    role_name = os.environ.get("ROLE_NAME")
    policy_arn = os.environ.get("POLICY_ARN")       # for managed policy
    inline_policy_name = os.environ.get("INLINE_POLICY_NAME")  # for inline policy

    try:
        if policy_arn:
            # Case 1: Remove managed policy
            logger.info(f"Detaching managed policy {policy_arn} from role {role_name}")
            iam.detach_role_policy(RoleName=role_name, PolicyArn=policy_arn)
            return {"status": "success", "action": "detached", "policy_arn": policy_arn}

        elif inline_policy_name:
            # Case 2: Remove inline policy
            logger.info(f"Deleting inline policy {inline_policy_name} from role {role_name}")
            iam.delete_role_policy(RoleName=role_name, PolicyName=inline_policy_name)
            return {"status": "success", "action": "deleted", "policy_name": inline_policy_name}

        else:
            raise ValueError("You must provide either POLICY_ARN (managed) or INLINE_POLICY_NAME (inline).")

    except Exception as e:
        logger.error(f"Error removing policy: {e}")
        raise
