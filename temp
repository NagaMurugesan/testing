import boto3
import botocore
import os

# Set your region here: us-gov-west-1 or us-gov-east-1
REGION = os.environ.get("AWS_REGION", "us-gov-west-1")

def main():
    try:
        # Create IAM client explicitly for GovCloud
        iam = boto3.client(
            "iam",
            region_name=REGION,
            endpoint_url="https://iam.us-gov.amazonaws.com"
        )

        # List the first 10 IAM roles
        response = iam.list_roles(MaxItems=10)
        roles = response.get("Roles", [])

        print(f"Found {len(roles)} roles:")
        for r in roles:
            print(f"- {r['RoleName']}")

        print("IAM connection successful ✅")

    except botocore.exceptions.EndpointConnectionError as e:
        print(f"Endpoint connection error: {e}")
    except botocore.exceptions.ClientError as e:
        print(f"Client error: {e}")
    except Exception as e:
        print(f"Unexpected error: {e}")

if __name__ == "__main__":
    main()
