import boto3
import os

cloudwatch = boto3.client('cloudwatch', region_name=os.environ['REGION'])

def lambda_handler(event, context):
    cloudwatch.put_metric_data(
        Namespace=os.environ['NAMESPACE'],
        MetricData=[{
            'MetricName': os.environ['METRIC_NAME'],
            'Value': 1,
            'Unit': 'Count'
        }]
    )
