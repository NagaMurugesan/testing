#!/bin/bash

# ====== CONFIGURATION ======
DB_HOST="your-db-endpoint.rds.amazonaws.com"
DB_PORT=3306
DB_NAME="your_db_name"
DB_USER="admin"
DB_PASSWORD="your_password"
DUMP_FILE="/tmp/rds_backup_$(date +%Y%m%d%H%M%S).sql"
BACKUP_DIR="/tmp/rds_backup"
RESTORE_FILE=""  # Leave empty to use latest dump
# ===========================

# Ensure backup directory exists
mkdir -p "$BACKUP_DIR"

# Export data using mysqldump
backup_rds() {
  echo "Backing up database $DB_NAME from $DB_HOST..."
  mysqldump -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" > "$DUMP_FILE"
  if [ $? -eq 0 ]; then
    echo "Backup successful: $DUMP_FILE"
  else
    echo "Backup failed."
    exit 1
  fi
}

# Restore data using mysql
restore_rds() {
  local file_to_restore="$RESTORE_FILE"

  # If no file specified, use the latest .sql file
  if [ -z "$file_to_restore" ]; then
    file_to_restore=$(ls -t "$BACKUP_DIR"/*.sql | head -n 1)
    echo "No restore file specified. Using latest backup: $file_to_restore"
  fi

  if [ -f "$file_to_restore" ]; then
    echo "Restoring database $DB_NAME from $file_to_restore..."
    mysql -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" < "$file_to_restore"
    if [ $? -eq 0 ]; then
      echo "Restore completed successfully."
    else
      echo "Restore failed."
      exit 1
    fi
  else
    echo "Restore file not found: $file_to_restore"
    exit 1
  fi
}

# Menu for actions
echo "Choose action:"
echo "1) Backup RDS"
echo "2) Restore RDS"
read -p "Enter choice [1-2]: " choice

case "$choice" in
  1)
    backup_rds
    ;;
  2)
    restore_rds
    ;;
  *)
    echo "Invalid choice"
    exit 1
    ;;
esac
