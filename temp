###############################################################################
# VARIABLES
###############################################################################
variable "region" {
  default = "us-west-2"
}

variable "ami_name" {
  default = "custom-ami"
}

variable "ami_version" {
  default = "1.0.0"
}

###############################################################################
# PROVIDER
###############################################################################
provider "aws" {
  region = var.region
}

###############################################################################
# IAM ROLE FOR IMAGE BUILDER
###############################################################################
resource "aws_iam_role" "imagebuilder_role" {
  name = "imagebuilder-service-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "imagebuilder.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "imagebuilder_policy_attach" {
  role       = aws_iam_role.imagebuilder_role.name
  policy_arn = "arn:aws:iam::aws:policy/AWSImageBuilderFullAccess"
}

###############################################################################
# IMAGE BUILDER COMPONENT - CUSTOM INSTALL SCRIPT
###############################################################################
resource "aws_imagebuilder_component" "custom_software" {
  name    = "custom-software-install"
  version = "1.0.0"
  platform = "Linux"
  description = "Installs custom software packages"

  data = <<-EOT
  name: CustomSoftwareInstall
  description: Installs Docker, Git, and Python3
  schemaVersion: 1.0
  phases:
    - name: build
      steps:
        - name: InstallPackages
          action: ExecuteBash
          inputs:
            commands:
              - sudo yum update -y
              - sudo yum install -y docker git python3
              - sudo systemctl enable docker
              - sudo systemctl start docker
              - echo "Custom software installation complete!"
  EOT
}

###############################################################################
# BASE IMAGE - Amazon Linux 2023
###############################################################################
data "aws_ssm_parameter" "amazon_linux_2023" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}

###############################################################################
# IMAGE RECIPE
###############################################################################
resource "aws_imagebuilder_image_recipe" "custom_recipe" {
  name         = "${var.ami_name}-recipe"
  version      = var.ami_version
  parent_image = data.aws_ssm_parameter.amazon_linux_2023.value

  component {
    component_arn = aws_imagebuilder_component.custom_software.arn
  }

  block_device_mapping {
    device_name = "/dev/xvda"
    ebs {
      volume_size = 20
      volume_type = "gp3"
      delete_on_termination = true
    }
  }
}

###############################################################################
# INFRASTRUCTURE CONFIGURATION
###############################################################################
resource "aws_imagebuilder_infrastructure_configuration" "infra_config" {
  name = "${var.ami_name}-infra-config"

  instance_types = ["t3.micro"]
  terminate_instance_on_failure = true
  instance_profile_name = aws_iam_instance_profile.imagebuilder_instance_profile.name

  security_group_ids = [aws_security_group.imagebuilder_sg.id]
  subnet_id          = aws_subnet.imagebuilder_subnet.id
}

###############################################################################
# NETWORKING (MINIMAL VPC SETUP)
###############################################################################
resource "aws_vpc" "imagebuilder_vpc" {
  cidr_block = "10.0.0.0/16"
}

resource "aws_subnet" "imagebuilder_subnet" {
  vpc_id                  = aws_vpc.imagebuilder_vpc.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "${var.region}a"
  map_public_ip_on_launch = true
}

resource "aws_security_group" "imagebuilder_sg" {
  vpc_id = aws_vpc.imagebuilder_vpc.id
  name   = "imagebuilder-sg"
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

###############################################################################
# DISTRIBUTION CONFIGURATION (OPTIONAL: PUBLISH TO MULTIPLE REGIONS)
###############################################################################
resource "aws_imagebuilder_distribution_configuration" "dist_config" {
  name = "${var.ami_name}-dist-config"

  distribution {
    region = var.region
    ami_distribution_configuration {
      name = "${var.ami_name}-${var.ami_version}-{{ imagebuilder:buildDate }}"
      description = "Custom AMI built using Image Builder-{{ imagebuilder:buildDate }}"
      target_account_ids = [] # Add other AWS account IDs to share AMI
    }
  }
}

###############################################################################
# IMAGE PIPELINE
###############################################################################
resource "aws_imagebuilder_image_pipeline" "custom_pipeline" {
  name                             = "${var.ami_name}-pipeline"
  description                      = "Pipeline to build custom AMI"
  image_recipe_arn                 = aws_imagebuilder_image_recipe.custom_recipe.arn
  infrastructure_configuration_arn = aws_imagebuilder_infrastructure_configuration.infra_config.arn
  distribution_configuration_arn   = aws_imagebuilder_distribution_configuration.dist_config.arn
  status                           = "ENABLED"

  schedule {
    schedule_expression = "cron(0 6 * * ? *)" # Daily 6 AM UTC build (optional)
    pipeline_execution_start_condition = "EXPRESSION_MATCH_ONLY"
  }
}

###############################################################################
# OUTPUTS
###############################################################################
output "imagebuilder_pipeline_name" {
  value = aws_imagebuilder_image_pipeline.custom_pipeline.name
}

output "imagebuilder_recipe_arn" {
  value = aws_imagebuilder_image_recipe.custom_recipe.arn
}
