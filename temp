#!/bin/bash

# Example input
tag_files=("file1.tag" "file2.tag")
current_node="file2.tag"

# Convert to Bash array (strip brackets and quotes, then split by comma)
IFS=',' read -r -a tag_array <<< "$(echo "$tag_files" | sed -e 's/[][]//g' -e 's/"//g')"


# Get last element of the list
last_tag="${tag_files[-1]}"

echo "Last tag in list: $last_tag"

# Check if last_tag matches current_node
if [[ "$last_tag" == "$current_node" ]]; then
  echo "Match found: $last_tag == $current_node"

  # Loop until all files exist
  while true; do
    all_exist=true

    for f in "${tag_files[@]}"; do
      if [[ ! -f "$f" ]]; then
        echo "File $f not found. Waiting..."
        all_exist=false
        break
      fi
    done

    if [[ "$all_exist" == true ]]; then
      echo "✅ All files are now available!"
      break
    fi

    # Sleep before re-checking
    sleep 120  # sleep 2 minutes (adjust as needed)
  done
else
  echo "No match: $last_tag != $current_node"
fi
