stages:
  - validate
  - build
  - deploy
  - install
  - verify
  - notify

variables:
  TF_VAR_env: "prod"
  REGION: "us-east-1"

validate:
  stage: validate
  script:
    - terraform fmt -check
    - terraform init
    - terraform validate

build_ami:
  stage: build
  script:
    - ./scripts/build-ami.sh   # (uses Packer if required)
  only:
    - schedules
    - manual

deploy_infra:
  stage: deploy
  script:
    - terraform apply -auto-approve
  artifacts:
    paths:
      - terraform.tfstate

install_boxi:
  stage: install
  script:
    - ./scripts/install-boxi.sh  # Can call Ansible or bash
  environment:
    name: production

verify:
  stage: verify
  script:
    - curl http://$BOXI_HOST:8080/BOE/BI > /dev/null || exit 1

notify:
  stage: notify
  script:
    - ./scripts/notify.sh "BOXI Rebuild Completed Successfully"
