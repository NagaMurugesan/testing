#!/bin/bash

# ---------------------------
# Variables
# ---------------------------
VOLUME1="/dev/xvdf"        # /dev/sdf maps to /dev/xvdf in Amazon Linux 2
VOLUME2="/dev/xvdh"        # /dev/sdh maps to /dev/xvdh
MOUNT_POINT1="/mnt/data1"
MOUNT_POINT2="/mnt/data2"
FILESYSTEM_TYPE="ext4"

# ---------------------------
# Update package manager and install required tools
# ---------------------------
sudo yum update -y
sudo yum install -y file

# ---------------------------
# Create mount points
# ---------------------------
sudo mkdir -p $MOUNT_POINT1
sudo mkdir -p $MOUNT_POINT2

# ---------------------------
# Format volumes if they are not already formatted
# ---------------------------
if ! sudo file -s $VOLUME1 | grep -q 'filesystem'; then
    sudo mkfs -t $FILESYSTEM_TYPE $VOLUME1
fi

if ! sudo file -s $VOLUME2 | grep -q 'filesystem'; then
    sudo mkfs -t $FILESYSTEM_TYPE $VOLUME2
fi

# ---------------------------
# Mount the volumes
# ---------------------------
sudo mount $VOLUME1 $MOUNT_POINT1
sudo mount $VOLUME2 $MOUNT_POINT2

# ---------------------------
# Backup fstab before editing
# ---------------------------
sudo cp /etc/fstab /etc/fstab.bak

# ---------------------------
# Get UUIDs and add to fstab for persistence
# ---------------------------
UUID1=$(sudo blkid -s UUID -o value $VOLUME1)
UUID2=$(sudo blkid -s UUID -o value $VOLUME2)

# Add entries to /etc/fstab if not already present
grep -q "$UUID1" /etc/fstab || echo "UUID=$UUID1 $MOUNT_POINT1 $FILESYSTEM_TYPE defaults,nofail 0 2" | sudo tee -a /etc/fstab
grep -q "$UUID2" /etc/fstab || echo "UUID=$UUID2 $MOUNT_POINT2 $FILESYSTEM_TYPE defaults,nofail 0 2" | sudo tee -a /etc/fstab

# ---------------------------
# Verify mounts
# ---------------------------
df -h



alternate

#!/bin/bash
# --------------------------------------------
# Script: auto_mount_ebs.sh
# Purpose: Automatically mount all attached EBS volumes (except root)
# Works on: Amazon Linux 2 / RHEL / Ubuntu
# --------------------------------------------

set -e

# Update packages and install dependencies
sudo yum install -y file util-linux

echo "🔍 Detecting attached EBS volumes..."

# Get list of block devices excluding the root volume
# Root device is typically /dev/xvda or /dev/nvme0n1
BLOCK_DEVICES=$(lsblk -ndo NAME,TYPE | awk '$2=="disk"{print $1}' | grep -vE 'xvda|nvme0n1')

if [ -z "$BLOCK_DEVICES" ]; then
  echo "❌ No extra EBS volumes detected."
  exit 0
fi

echo "✅ Found volumes: $BLOCK_DEVICES"

MOUNT_BASE="/mnt"
FILESYSTEM_TYPE="ext4"
COUNT=1

for DEV in $BLOCK_DEVICES; do
  DEVICE_PATH="/dev/$DEV"
  MOUNT_POINT="$MOUNT_BASE/volume$COUNT"

  echo "----------------------------------------"
  echo "🔧 Processing $DEVICE_PATH"
  echo "📁 Mount point: $MOUNT_POINT"

  # Create mount directory
  sudo mkdir -p $MOUNT_POINT

  # Check if device already has a filesystem
  if sudo file -s $DEVICE_PATH | grep -q 'filesystem'; then
    echo "🟢 $DEVICE_PATH already has a filesystem. Skipping format."
  else
    echo "⚙️ Formatting $DEVICE_PATH as $FILESYSTEM_TYPE"
    sudo mkfs -t $FILESYSTEM_TYPE $DEVICE_PATH
  fi

  # Mount the volume
  echo "📦 Mounting $DEVICE_PATH to $MOUNT_POINT"
  sudo mount $DEVICE_PATH $MOUNT_POINT

  # Get UUID for persistent mounting
  UUID=$(sudo blkid -s UUID -o value $DEVICE_PATH)

  # Add to /etc/fstab if not already present
  if ! grep -q "$UUID" /etc/fstab; then
    echo "📝 Adding $MOUNT_POINT to /etc/fstab"
    echo "UUID=$UUID $MOUNT_POINT $FILESYSTEM_TYPE defaults,nofail 0 2" | sudo tee -a /etc/fstab
  fi

  ((COUNT++))
done

echo "✅ All volumes have been mounted successfully."
echo "----------------------------------------"
df -h | grep "$MOUNT_BASE"

