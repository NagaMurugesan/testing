#!/bin/bash
# File: scripts/setup-letsencrypt.sh

set -e

DOMAIN="chat.example.com"
EMAIL="admin@example.com"

echo "Installing Certbot..."
sudo dnf install -y certbot

echo "Stopping nginx-proxy to free port 80..."
docker compose stop nginx-proxy

echo "Generating Let's Encrypt certificate for $DOMAIN..."
sudo certbot certonly \
  --standalone \
  --non-interactive \
  --agree-tos \
  --email $EMAIL \
  -d $DOMAIN

echo "Copying certificates to app directory..."
sudo mkdir -p certs
sudo cp /etc/letsencrypt/live/$DOMAIN/fullchain.pem certs/
sudo cp /etc/letsencrypt/live/$DOMAIN/privkey.pem certs/
sudo chmod 644 certs/*.pem

echo "Updating .env.production with certificate paths..."
cat > .env.production << EOF
ENVIRONMENT=production
DOMAIN=$DOMAIN
API_URL=https://$DOMAIN/api
FRONTEND_URL=https://$DOMAIN
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
EOF

echo "Starting services..."
docker compose --env-file .env.production up -d

echo "✅ Let's Encrypt certificate installed successfully!"
echo "Certificate will auto-renew via cron job"

# Setup auto-renewal
echo "Setting up auto-renewal..."
sudo crontab -l 2>/dev/null | { cat; echo "0 0 * * * certbot renew --quiet && cp /etc/letsencrypt/live/$DOMAIN/*.pem /home/ec2-user/app/certs/ && docker compose restart nginx-proxy"; } | sudo crontab -
