#!/bin/bash

# ====== CONFIGURATION ======
DB_HOST="your-db-endpoint.rds.amazonaws.com"
DB_PORT=3306
DB_USER="admin"
DB_PASSWORD="your_password"

BACKUP_DIR="/tmp/rds_backup"
RESTORE_DIR="$BACKUP_DIR"
# ===========================

mkdir -p "$BACKUP_DIR"

# Function to backup specified databases
backup_dbs() {
  for db in "$@"; do
    DUMP_FILE="${BACKUP_DIR}/${db}_backup_$(date +%Y%m%d%H%M%S).sql"
    echo "📦 Backing up database: $db"
    mysqldump -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"$DB_PASSWORD" "$db" > "$DUMP_FILE"
    if [ $? -eq 0 ]; then
      echo "✅ Backup successful: $DUMP_FILE"
    else
      echo "❌ Backup failed for $db"
    fi
  done
}

# Function to restore specified databases
restore_dbs() {
  for db in "$@"; do
    # Find latest backup file for this DB
    RESTORE_FILE=$(ls -t "${RESTORE_DIR}/${db}_backup_"*.sql 2>/dev/null | head -n 1)
    if [ -f "$RESTORE_FILE" ]; then
      echo "♻️ Restoring database: $db from $RESTORE_FILE"
      mysql -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"$DB_PASSWORD" "$db" < "$RESTORE_FILE"
      if [ $? -eq 0 ]; then
        echo "✅ Restore successful: $db"
      else
        echo "❌ Restore failed for $db"
      fi
    else
      echo "⚠️ No backup file found for $db"
    fi
  done
}

# Function to show usage
usage() {
  echo "Usage: $0 [backup|restore] db1 [db2 ... dbN]"
  echo "Example: $0 backup mydb1 mydb2"
  exit 1
}

# ========= MAIN LOGIC =========

ACTION="$1"
shift  # Remaining args are DB names

if [ -z "$ACTION" ] || [ $# -eq 0 ]; then
  usage
fi

case "$ACTION" in
  backup)
    backup_dbs "$@"
    ;;
  restore)
    restore_dbs "$@"
    ;;
  *)
    usage
    ;;
esac
