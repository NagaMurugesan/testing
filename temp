#!/bin/bash

# ----------------------------------------
# Script: rds_backup_restore.sh
# Usage:
#   ./rds_backup_restore.sh backup [db1 db2 ...]
#   ./rds_backup_restore.sh restore [db1 db2 ...]
# Description:
#   Backup or restore multiple MySQL databases in Aurora RDS
# ----------------------------------------

# RDS connection details
RDS_HOST="your-rds-endpoint.amazonaws.com"
RDS_USER="admin"
RDS_PASSWORD="yourpassword"
BACKUP_DIR="/path/to/backup"

# Default databases to backup if none are passed
DEFAULT_DATABASES=("db1" "db2" "db3")

# Check arguments
ACTION=$1
shift # Remove the action from the arguments list

# Use provided DB list or fall back to defaults
if [ "$#" -gt 0 ]; then
    DATABASES=("$@")
else
    DATABASES=("${DEFAULT_DATABASES[@]}")
fi

# Create backup directory if not exists
mkdir -p "$BACKUP_DIR"

# Function: Backup
backup_databases() {
    for DB in "${DATABASES[@]}"; do
        echo "Backing up database: $DB"
        mysqldump --single-transaction \
                  -h "$RDS_HOST" \
                  -u "$RDS_USER" \
                  -p"$RDS_PASSWORD" \
                  "$DB" > "$BACKUP_DIR/${DB}_$(date +%F_%H-%M-%S).sql"

        if [ $? -eq 0 ]; then
            echo "✅ Backup successful for $DB"
        else
            echo "❌ Backup failed for $DB"
        fi
    done
}

# Function: Restore
restore_databases() {
    for DB in "${DATABASES[@]}"; do
        LATEST_BACKUP=$(ls -t "$BACKUP_DIR"/${DB}_*.sql 2>/dev/null | head -n 1)
        if [ -z "$LATEST_BACKUP" ]; then
            echo "⚠️ No backup file found for $DB"
            continue
        fi

        echo "Dropping and recreating database: $DB"
        mysql -h "$RDS_HOST" -u "$RDS_USER" -p"$RDS_PASSWORD" -e "DROP DATABASE IF EXISTS \`$DB\`; CREATE DATABASE \`$DB\`;"

        echo "Restoring database: $DB from $LATEST_BACKUP"
        mysql -h "$RDS_HOST" -u "$RDS_USER" -p"$RDS_PASSWORD" "$DB" < "$LATEST_BACKUP"

        if [ $? -eq 0 ]; then
            echo "✅ Restore successful for $DB"
        else
            echo "❌ Restore failed for $DB"
        fi
    done
}

# Main logic
case "$ACTION" in
    backup)
        backup_databases
        ;;
    restore)
        restore_databases
        ;;
    *)
        echo "Usage: $0 {backup|restore} [db1 db2 ...]"
        exit 1
        ;;
esac
