#!/bin/bash

# ---------------------------
# Variables
# ---------------------------
VOLUME1="/dev/xvdf"        # /dev/sdf maps to /dev/xvdf in Amazon Linux 2
VOLUME2="/dev/xvdh"        # /dev/sdh maps to /dev/xvdh
MOUNT_POINT1="/mnt/data1"
MOUNT_POINT2="/mnt/data2"
FILESYSTEM_TYPE="ext4"

# ---------------------------
# Update package manager and install required tools
# ---------------------------
sudo yum update -y
sudo yum install -y file

# ---------------------------
# Create mount points
# ---------------------------
sudo mkdir -p $MOUNT_POINT1
sudo mkdir -p $MOUNT_POINT2

# ---------------------------
# Format volumes if they are not already formatted
# ---------------------------
if ! sudo file -s $VOLUME1 | grep -q 'filesystem'; then
    sudo mkfs -t $FILESYSTEM_TYPE $VOLUME1
fi

if ! sudo file -s $VOLUME2 | grep -q 'filesystem'; then
    sudo mkfs -t $FILESYSTEM_TYPE $VOLUME2
fi

# ---------------------------
# Mount the volumes
# ---------------------------
sudo mount $VOLUME1 $MOUNT_POINT1
sudo mount $VOLUME2 $MOUNT_POINT2

# ---------------------------
# Backup fstab before editing
# ---------------------------
sudo cp /etc/fstab /etc/fstab.bak

# ---------------------------
# Get UUIDs and add to fstab for persistence
# ---------------------------
UUID1=$(sudo blkid -s UUID -o value $VOLUME1)
UUID2=$(sudo blkid -s UUID -o value $VOLUME2)

# Add entries to /etc/fstab if not already present
grep -q "$UUID1" /etc/fstab || echo "UUID=$UUID1 $MOUNT_POINT1 $FILESYSTEM_TYPE defaults,nofail 0 2" | sudo tee -a /etc/fstab
grep -q "$UUID2" /etc/fstab || echo "UUID=$UUID2 $MOUNT_POINT2 $FILESYSTEM_TYPE defaults,nofail 0 2" | sudo tee -a /etc/fstab

# ---------------------------
# Verify mounts
# ---------------------------
df -h
