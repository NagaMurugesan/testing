resource "aws_ssm_parameter" "app_config" {
  name        = "/myapp/config/db_url"
  description = "Database connection string"
  type        = "SecureString" # or "String"
  value       = "postgres://user:password@host:5432/dbname"
  overwrite   = true
}

resource "aws_iam_role" "ec2_ssm_role" {
  name = "ec2_ssm_parameter_access_role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ec2.amazonaws.com"
        }
      }
    ]
  })
}

resource "aws_iam_policy" "ssm_read_policy" {
  name = "SSMReadParameterPolicy"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "ssm:GetParameter",
          "ssm:GetParameters"
        ]
        Resource = "arn:aws:ssm:${var.region}:${data.aws_caller_identity.current.account_id}:parameter/myapp/config/*"
      }
    ]
  })
}

resource "aws_iam_role_policy_attachment" "attach_policy" {
  role       = aws_iam_role.ec2_ssm_role.name
  policy_arn = aws_iam_policy.ssm_read_policy.arn
}

resource "aws_iam_instance_profile" "ec2_instance_profile" {
  name = "ec2_ssm_instance_profile"
  role = aws_iam_role.ec2_ssm_role.name
}


resource "aws_instance" "my_ec2" {
  ami           = "ami-xxxxxxxxxxxx" # Replace with valid AMI ID
  instance_type = "t2.micro"

  iam_instance_profile = aws_iam_instance_profile.ec2_instance_profile.name

  tags = {
    Name = "EC2WithSSMAccess"
  }

  # Add user_data script if you want to run the script on boot
}



#!/bin/bash

# Fetch plain string
aws ssm get-parameter --name "/myapp/config/db_url" --with-decryption --query "Parameter.Value" --output text
